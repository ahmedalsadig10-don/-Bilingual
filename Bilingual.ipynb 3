              "<span style=\"color: #008000; text-decoration-color: #008000\">│</span>  <span style=\"color: #00ff00; text-decoration-color: #00ff00\"># SECTION 2: ARABIC (العربية)</span>                                                                                  <span style=\"color: #008000; text-decoration-color: #008000\">│</span>\n",
              "<span style=\"color: #008000; text-decoration-color: #008000\">│</span>                                                                                                                 <span style=\"color: #008000; text-decoration-color: #008000\">│</span>\n",
              "<span style=\"color: #008000; text-decoration-color: #008000\">│</span>  <span style=\"color: #00ff00; text-decoration-color: #00ff00\">## تقرير تفصيلي: الاتجاهات الرئيسية للذكاء الاصطناعي في الرعاية الصحية لعام 2026</span>                               <span style=\"color: #008000; text-decoration-color: #008000\">│</span>\n",
