        "import os\n",
        "from google.colab import userdata\n",
        "from crewai import LLM\n",
        "\n",
        "# Securely load your Gemini API Key from Colab Secrets\n",
        "gemini_key = userdata.get(\"GEMINI_API_KEY\")\n",
        "\n",
        "if not gemini_key:\n",
        "    # Fallback to check for GEMINI_API_KEY if GOOGLE_API_KEY is not defined\n",
        "    gemini_key = userdata.get(\"GEMINI_API_KEY\")\n",
        "\n",
        "if not gemini_key:\n",
        "    raise ValueError(\"Please add your GOOGLE_API_KEY or GEMINI_API_KEY to the 🔑 Secrets panel and enable notebook access.\")\n",
        "\n",
        "# Export only one key to prevent SDK collision warnings\n",
        "os.environ[\"GEMINI_API_KEY\"] =gemini_key\n",
        "if \"GOOGLE_API_KEY\" in os.environ:\n",
        "    del os.environ[\"GOOGLE_API_KEY\"]\n",
        "\n",
        "# Configure the Gemini LLM for CrewAI using the correct active stable model name\n",
        "gemini_llm = LLM(\n",
        "    model=\"gemini/gemini-3.6-flash\", # Updated model name to gemini-3.6-flash\n",
        "    api_key=gemini_key\n",
        ")\n",
        "\n",
        "# Re-initialize agents to use Gemini\n",
        "researcher.llm = gemini_llm\n",
        "writer.llm = gemini_llm\n",
        "\n",
        "print(\"Agents successfully configured! Model updated to gemini-3.6-flash.\")"
